							<Value Class="CodeValue">
								<Code><![CDATA[CheckpointTraveller traveller = (CheckpointTraveller) agent;
traveller.security_queue_join = time();
security_queue_count++;]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onSeizeUnit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[((CheckpointTraveller) agent).security_resource_id = "SECURITY_01";]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnterDelay]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[CheckpointTraveller traveller = (CheckpointTraveller) agent;
security_queue_count--;
security_in_service_count++;
traveller.security_start = time();]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[CheckpointTraveller traveller = (CheckpointTraveller) agent;
