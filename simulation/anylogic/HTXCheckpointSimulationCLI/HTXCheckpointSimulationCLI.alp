				Boolean.toString( root.guard_hit ),
				"AnyLogic PLE 8.9.9.202607020720"
			}
		)
		+ "\n";

	StringBuilder ledger = new StringBuilder(
		"schema_version,experiment_role,readiness_scope,source_config_id,"
		+ "input_sample_id,replication_id,arrival_seed,sequence,arrival_time\n"
	);
	for ( int index = 0; index &lt; root.arrival_times.size(); index++ ) {
		ledger.append(
