	<Experiments>
		<ParamVariationExperiment ActiveObjectClassId="1785082971961">
			<Id>1785085122430</Id>
			<Name><![CDATA[GatePV2x3]]></Name>
			<CommandLineArguments/>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeEachExperimentRunCode>java.io.File probe = new java.io.File(
		System.getProperty( "htx.repo.root", System.getProperty( "user.dir" ) )
	).getAbsoluteFile();
	while (
		probe != null
		&amp;&amp; !new java.io.File( probe, "config/anylogic_gate_manifest.csv" ).isFile()
	) {
		probe = probe.getParentFile();
	}
	if ( probe == null ) {
		throw new IllegalStateException(
			"Cannot locate repository root from user.dir="
			+ System.getProperty( "user.dir" )
			+ "; set -Dhtx.repo.root=&lt;repository path&gt;"
		);
	}
	java.io.File outputDirectory = new java.io.File(
		probe,
		"results/raw/anylogic_gate"
	).getAbsoluteFile();
	gate_output_dir = outputDirectory.getPath();
	try {
		java.nio.file.Files.createDirectories( outputDirectory.toPath() );
		java.nio.file.Files.write(
			new java.io.File( outputDirectory, "run_manifest.csv" ).toPath(),
			(
				"schema_version,config_hash,model_version,scenario_id,input_sample_id,"
				+ "replication_id,stream_seed_ids,start_state,arrival_cutoff,drain_end,"
				+ "engine_version\n"
			).getBytes( java.nio.charset.StandardCharsets.UTF_8 ),
			java.nio.file.StandardOpenOption.CREATE,
			java.nio.file.StandardOpenOption.TRUNCATE_EXISTING,
			java.nio.file.StandardOpenOption.WRITE
		);
		java.nio.file.Files.write(
			new java.io.File( outputDirectory, "entity_log.csv" ).toPath(),
			(
				"schema_version,scenario_id,input_sample_id,replication_id,stream_seed_ids,"
				+ "traveller_id,arrival,security_queue_join,security_start,security_end,"
				+ "immigration_queue_join,immigration_lane,immigration_start,"
				+ "immigration_primary_end,additional_check_flag,additional_check_end,"
				+ "technology_flag,exit,security_resource_id,immigration_resource_id,"
				+ "service_demand\n"
			).getBytes( java.nio.charset.StandardCharsets.UTF_8 ),
			java.nio.file.StandardOpenOption.CREATE,
			java.nio.file.StandardOpenOption.TRUNCATE_EXISTING,
			java.nio.file.StandardOpenOption.WRITE
		);
		java.nio.file.Files.write(
			new java.io.File( outputDirectory, "run_summary.csv" ).toPath(),
			(
				"schema_version,scenario_id,input_sample_id,replication_id,stream_seed_ids,"
				+ "arrivals,completed_at_cutoff,wip_at_cutoff,completed_after_drain,"
				+ "security_wait_mean,security_wait_p95,total_wait_mean,total_wait_p95,"
				+ "cutoff_backlog,cohort_clear_time\n"
			).getBytes( java.nio.charset.StandardCharsets.UTF_8 ),
			java.nio.file.StandardOpenOption.CREATE,
			java.nio.file.StandardOpenOption.TRUNCATE_EXISTING,
			java.nio.file.StandardOpenOption.WRITE
		);
	} catch ( java.io.IOException exception ) {
		throw new RuntimeException( "Cannot initialise AnyLogic gate outputs", exception );
	}</BeforeEachExperimentRunCode>
			<BeforeSimulationRunCode>int replication = getCurrentReplication();
