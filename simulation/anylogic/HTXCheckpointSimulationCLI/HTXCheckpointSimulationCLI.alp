	getEngine().getDefaultRandomGenerator().setSeed( root.arrival_seed );
	root.presentation_animation_enabled = true;</BeforeSimulationRunCode>
			<AfterSimulationRunCode>if ( !"COMPLETE".equals( root.run_status ) )
		throw new IllegalStateException( "operational run did not reach COMPLETE" );
	if ( root.guard_hit || root.rejected_or_dropped_count != 0 )
		throw new IllegalStateException( "guard, rejection, or drop detected" );
	if ( root.admitted != root.completed )
		throw new IllegalStateException( "full-drain conservation failed" );
	if ( root.security_queue_count != 0 || root.security_in_service_count != 0
		|| root.immigration_queue_count != 0 || root.immigration_in_service_count != 0 )
		throw new IllegalStateException( "non-zero WIP after drain" );
	int wipAtCutoff =
		root.security_queue_at_cutoff + root.security_in_service_at_cutoff
		+ root.immigration_queue_at_cutoff + root.immigration_in_service_at_cutoff;
	boolean conservationPass =
		root.admitted_at_cutoff == root.completed_at_cutoff + wipAtCutoff;
	if ( !conservationPass )
		throw new IllegalStateException( "cutoff conservation failed" );

	java.util.ArrayList&lt;Double&gt; securitySorted =
		new java.util.ArrayList&lt;Double&gt;( root.security_waits );
	java.util.ArrayList&lt;Double&gt; immigrationSorted =
		new java.util.ArrayList&lt;Double&gt;( root.immigration_waits );
	java.util.ArrayList&lt;Double&gt; totalSorted =
		new java.util.ArrayList&lt;Double&gt;( root.total_queue_waits );
	java.util.ArrayList&lt;Double&gt; systemSorted =
		new java.util.ArrayList&lt;Double&gt;( root.system_times );
	java.util.Collections.sort( securitySorted );
	java.util.Collections.sort( immigrationSorted );
	java.util.Collections.sort( totalSorted );
	java.util.Collections.sort( systemSorted );
	double securitySum = 0.0, immigrationSum = 0.0, totalSum = 0.0, systemSum = 0.0;
	for ( double value : securitySorted ) securitySum += value;
	for ( double value : immigrationSorted ) immigrationSum += value;
	for ( double value : totalSorted ) totalSum += value;
	for ( double value : systemSorted ) systemSum += value;
