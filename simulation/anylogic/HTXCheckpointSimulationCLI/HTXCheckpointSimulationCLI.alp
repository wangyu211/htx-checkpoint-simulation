						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if ( arrival_times.size() + 1 >= ple_max_generated_guard ) {
	guard_hit = true;
	travellerSource.set_rate( 0.0, PER_SECOND );
	throw new IllegalStateException(
		"HPP arrival guard reached before cutoff: "
		+ ple_max_generated_guard
	);
}
double arrivalTime = time();
if ( arrivalTime < 0.0 || arrivalTime >= arrival_cutoff_seconds ) {
	throw new IllegalStateException(
		"HPP arrival outside [0, cutoff): " + arrivalTime
	);
}
if (
	!arrival_times.isEmpty()
	&& arrivalTime <= arrival_times.get( arrival_times.size() - 1 )
) {
	throw new IllegalStateException(
		"HPP arrival timestamps are not strictly increasing"
	);
}
arrival_times.add( arrivalTime );]]></Code>
							</Value>
