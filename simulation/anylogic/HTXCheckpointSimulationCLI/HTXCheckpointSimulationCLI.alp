			<PresentationProperties>
				<EnableZoomAndPanning>true</EnableZoomAndPanning>
				<Title>HTXCheckpointSimulation : CapacityAvailabilityStress</Title>
				<EnableDeveloperPanel>true</EnableDeveloperPanel>
				<ShowDeveloperPanelOnStart>false</ShowDeveloperPanelOnStart>
			</PresentationProperties>
			<ReplicationsProperties>
				<UseReplication>true</UseReplication>
				<FixedReplicationsNumber>true</FixedReplicationsNumber>
				<ReplicationPerIteration>50</ReplicationPerIteration>
				<MinimumReplication>50</MinimumReplication>
				<MaximumReplication>50</MaximumReplication>
