			root.input_sample_id,
			Integer.toString( root.replication_id ),
			streamSeedIds,
			Integer.toString( root.next_traveller_id ),
			Integer.toString( root.completed_travellers ),
			Integer.toString( cutoffBacklog ),
			Integer.toString( root.completed_travellers ),
			String.format( java.util.Locale.ROOT, "%.9f", securityWaitMean ),
			String.format( java.util.Locale.ROOT, "%.9f", securityWaitP95 ),
			String.format( java.util.Locale.ROOT, "%.9f", systemTimeMean ),
			String.format( java.util.Locale.ROOT, "%.9f", systemTimeP95 ),
			Integer.toString( cutoffBacklog ),
			String.format( java.util.Locale.ROOT, "%.9f", root.last_exit )
		}
	) + "\n";
	String entityRows = String.join( "\n", root.entity_rows ) + "\n";

