			<AfterSimulationRunCode>if (
		root.next_traveller_id != root.gate_entity_count
		|| root.completed_travellers != root.gate_entity_count
	) {
		throw new IllegalStateException(
			"Incomplete gate run "
			+ root.input_sample_id
