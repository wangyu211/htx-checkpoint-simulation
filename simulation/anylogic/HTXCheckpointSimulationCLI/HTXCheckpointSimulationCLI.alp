		<ParamVariationExperiment ActiveObjectClassId="1785162520364">
			<Id>1785162970001</Id>
			<Name><![CDATA[ServiceVariabilitySensitivity]]></Name>
			<CommandLineArguments/>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeSimulationRunCode>root.presentation_animation_enabled = false;
	if ( !"1.0".equals( root.schema_version ) )
		throw new IllegalArgumentException( "schema_version must be 1.0" );
	if ( !root.config_sha256.matches( "[0-9a-f]{64}" ) )
		throw new IllegalArgumentException( "config_sha256 must be 64 lowercase hex characters" );
	if ( !root.output_collection_id.matches( "[a-z0-9_]+" ) )
		throw new IllegalArgumentException( "output_collection_id is unsafe" );
	if ( !"HPP".equals( root.arrival_mode ) )
		throw new IllegalArgumentException( "arrival_mode must be HPP" );
	if ( !( root.arrival_rate_per_second &gt; 0.0 ) || !( root.demand_multiplier &gt; 0.0 ) )
		throw new IllegalArgumentException( "arrival rate and demand multiplier must be positive" );
	if ( !( root.arrival_cutoff_seconds &gt; 0.0 ) || root.arrival_guard &lt;= 1 )
		throw new IllegalArgumentException( "arrival cutoff and guard are invalid" );
	if ( root.arrival_rate_per_second * root.demand_multiplier * root.arrival_cutoff_seconds &gt;= root.arrival_guard )
		throw new IllegalArgumentException( "arrival_guard must exceed expected arrivals" );
	if ( !"FULL_DRAIN".equals( root.drain_rule ) )
		throw new IllegalArgumentException( "drain_rule must be FULL_DRAIN" );
	if ( root.security_capacity &lt;= 0 || root.immigration_capacity &lt;= 0 )
		throw new IllegalArgumentException( "resource capacities must be positive" );
	if ( root.security_queue_capacity &lt;= 0 || root.immigration_queue_capacity &lt;= 0 )
		throw new IllegalArgumentException( "queue capacities must be positive" );
	if ( !( root.security_service_p1_seconds &gt; 0.0 )
		|| !( root.immigration_service_p1_seconds &gt; 0.0 ) )
		throw new IllegalArgumentException( "primary service demands must be positive" );
	boolean securityServiceContractValid =
		( "FIXED".equals( root.security_service_distribution )
			&amp;&amp; root.security_service_cv == 0.0 )
		|| ( "LOGNORMAL_MEAN_CV".equals( root.security_service_distribution )
			&amp;&amp; root.security_service_cv &gt; 0.0
			&amp;&amp; root.security_service_cv &lt;= 2.0
			&amp;&amp; Double.isFinite( root.security_service_cv ) );
	boolean immigrationServiceContractValid =
		( "FIXED".equals( root.immigration_service_distribution )
			&amp;&amp; root.immigration_service_cv == 0.0 )
		|| ( "LOGNORMAL_MEAN_CV".equals( root.immigration_service_distribution )
			&amp;&amp; root.immigration_service_cv &gt; 0.0
			&amp;&amp; root.immigration_service_cv &lt;= 2.0
			&amp;&amp; Double.isFinite( root.immigration_service_cv ) );
	if ( !securityServiceContractValid || !immigrationServiceContractValid )
		throw new IllegalArgumentException(
			"primary service distribution/CV contract is invalid"
		);
	if ( "TASK3_OPERATIONAL_POOLED_V1".equals( root.model_version )
		&amp;&amp; ( !"FIXED".equals( root.security_service_distribution )
			|| !"FIXED".equals( root.immigration_service_distribution )
			|| root.security_service_cv != 0.0
			|| root.immigration_service_cv != 0.0 ) )
		throw new IllegalArgumentException(
			"TASK3_OPERATIONAL_POOLED_V1 is frozen to FIXED service and CV=0"
		);
	if ( !"pooled".equals( root.queue_policy ) )
		throw new IllegalArgumentException( "v1 implements pooled FCFS only" );
	if ( "DISABLED".equals( root.automation_mapping_mode ) ) {
		if ( root.automation_uptake != 0.0 || root.automation_multiplier != 1.0 )
			throw new IllegalArgumentException( "DISABLED automation requires uptake=0 and multiplier=1" );
	} else if ( "MULTIPLIER".equals( root.automation_mapping_mode ) ) {
		if ( !( root.automation_uptake &gt; 0.0 &amp;&amp; root.automation_uptake &lt;= 1.0 )
			|| !( root.automation_multiplier &gt; 0.0 &amp;&amp; root.automation_multiplier &lt; 1.0 ) )
			throw new IllegalArgumentException( "automation inputs are outside their domains" );
	} else {
		throw new IllegalArgumentException( "unknown automation_mapping_mode" );
	}
	if ( "NONE".equals( root.additional_check_semantics ) ) {
		if ( root.additional_check_probability_conventional != 0.0
			|| root.additional_check_probability_technology != 0.0
			|| !"UNSET".equals( root.additional_check_service_distribution )
			|| root.additional_check_service_p1_seconds != 0.0 )
			throw new IllegalArgumentException( "NONE additional-check contract violated" );
	} else if ( "COUNTER_HELD_RISK_REFERRAL_PROXY".equals( root.additional_check_semantics ) ) {
		if ( !"FIXED".equals( root.additional_check_service_distribution )
			|| root.additional_check_probability_conventional &lt; 0.0
			|| root.additional_check_probability_conventional &gt; 1.0
			|| root.additional_check_probability_technology &lt; 0.0
			|| root.additional_check_probability_technology &gt; 1.0
			|| !( root.additional_check_service_p1_seconds &gt; 0.0 ) )
			throw new IllegalArgumentException( "risk-proxy inputs are invalid" );
	} else {
		throw new IllegalArgumentException( "unknown additional_check_semantics" );
	}
	if ( !"EMPTY_AND_IDLE".equals( root.start_state )
		|| !"NOT_CALIBRATED".equals( root.calibration_status )
		|| !"COMPARATIVE_WHAT_IF_ONLY".equals( root.claim_ceiling )
		|| !( "NOT_TESTED".equals( root.crn_alignment_status )
			|| "PENDING_VALIDATION".equals( root.crn_alignment_status ) ) )
		throw new IllegalArgumentException( "claim-boundary fields were weakened" );
	if ( !"TASK3_OPERATIONAL_POOLED_SERVICE_VARIABILITY_V1".equals( root.model_version ) )
		throw new IllegalArgumentException(
			"ServiceVariabilitySensitivity model_version mismatch"
		);
	if ( !"service_variability".equals( root.output_collection_id ) )
		throw new IllegalArgumentException(
			"ServiceVariabilitySensitivity output collection mismatch"
		);
	if ( root.master_seed != 202607290000L )
		throw new IllegalArgumentException(
			"ServiceVariabilitySensitivity master seed mismatch"
		);
	String expectedConfigId = null;
	String expectedConfigHash = null;
	if ( "SERVICE_VARIABILITY_SCV000_ICV000".equals( root.scenario_id )
		&amp;&amp; "LOCAL_WINDOW_HPP_BASE".equals( root.input_sample_id ) ) {
		expectedConfigId = "OP_SERVICE_VARIABILITY_SCV000_ICV000";
		expectedConfigHash = "be74beb301453572eb4b8b9417ed945f20d0b200bff7755ce6dd3e66a4a4e13a";
	}
	else if ( "SERVICE_VARIABILITY_SCV000_ICV050".equals( root.scenario_id )
		&amp;&amp; "LOCAL_WINDOW_HPP_BASE".equals( root.input_sample_id ) ) {
		expectedConfigId = "OP_SERVICE_VARIABILITY_SCV000_ICV050";
		expectedConfigHash = "fd37b40406df63f0ce0fc55e5c2df2a3f16016661be5ccc013c8ed063694ce07";
	}
	else if ( "SERVICE_VARIABILITY_SCV000_ICV100".equals( root.scenario_id )
