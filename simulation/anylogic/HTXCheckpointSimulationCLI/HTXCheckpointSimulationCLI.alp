	} else if ( "MULTIPLIER".equals( root.automation_mapping_mode ) ) {
		if ( !( root.automation_uptake &gt; 0.0 &amp;&amp; root.automation_uptake &lt;= 1.0 )
			|| !( root.automation_multiplier &gt; 0.0 &amp;&amp; root.automation_multiplier &lt; 1.0 ) )
