							<EntityEmbeddedObject>
								<Id>1785163120002</Id>
								<ActiveObjectClass>
									<PackageName>htx.checkpoint</PackageName>
									<ClassName>OperationalTraveller</ClassName>
								</ActiveObjectClass>
