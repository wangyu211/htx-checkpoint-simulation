			+ "technology_count,additional_check_count,"
			+ "security_wait_mean_seconds,security_wait_p95_seconds,"
			+ "immigration_wait_mean_seconds,immigration_wait_p95_seconds,"
			+ "total_queue_wait_mean_seconds,total_queue_wait_p95_seconds,"
			+ "total_queue_wait_exceed_600_rate,total_queue_wait_exceed_900_rate,"
			+ "total_queue_wait_exceed_1200_rate,system_time_mean_seconds,"
			+ "system_time_p95_seconds,security_utilization,immigration_utilization,"
			+ "cutoff_backlog,cutoff_backlog_fraction,"
			+ "cohort_clear_time_after_cutoff_seconds,conservation_pass,run_status"
		);
		kpis.add( String.join( ",", new String[] {
			root.schema_version, root.config_id, root.config_sha256, root.model_version,
			root.scenario_id, root.input_sample_id, Integer.toString( root.replication_id ),
			number.apply( root.arrival_cutoff_seconds ), number.apply( drainEnd ),
