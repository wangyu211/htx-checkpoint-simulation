		|| root.arrival_cutoff_seconds != 300.0
		|| root.arrival_guard != 5000
		|| root.security_queue_capacity != 5000
		|| root.security_service_p1_seconds != 21.818181818
		|| root.immigration_queue_capacity != 5000
		|| root.immigration_service_p1_seconds != 13.0
		|| !"pooled".equals( root.queue_policy )
		|| !"NONE".equals( root.additional_check_semantics )
		|| root.additional_check_probability_conventional != 0.0
		|| root.additional_check_probability_technology != 0.0
		|| !"UNSET".equals( root.additional_check_service_distribution )
