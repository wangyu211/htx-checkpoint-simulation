			<BeforeSimulationRunCode>if (
		!"BASELINE_LOCAL_WINDOW_HPP".equals( root.source_config_id )
		|| !"task1_final_aggregate".equals( root.arrival_evidence_id )
		|| !"LOCAL_WINDOW_HPP_STATIONARY_INDEPENDENT".equals(
			root.arrival_assumption
		)
		|| root.input_sample_id == null
		|| root.input_sample_id.trim().isEmpty()
	) {
		throw new IllegalStateException(
			"HPP arrival verification lineage is not frozen"
		);
	}
	if (
		!Double.isFinite( root.arrival_rate_per_second )
		|| root.arrival_rate_per_second &lt;= 0.0
		|| !Double.isFinite( root.arrival_cutoff_seconds )
		|| root.arrival_cutoff_seconds &lt;= 0.0
		|| root.arrival_seed &lt;= 0L
	) {
		throw new IllegalStateException(
			"HPP arrival verification parameters violate the fail-fast domain"
		);
	}
	double expectedCount =
		root.arrival_rate_per_second * root.arrival_cutoff_seconds;
	if (
		root.ple_max_generated_guard &lt;= 0
		|| root.ple_max_generated_guard &gt;= 50000
		|| expectedCount + 10.0 * Math.sqrt( expectedCount )
			&gt;= root.ple_max_generated_guard
	) {
		throw new IllegalStateException(
			"HPP arrival guard is unsafe for the configured exposure"
		);
	}
	getEngine().getDefaultRandomGenerator().setSeed( root.arrival_seed );</BeforeSimulationRunCode>
			<AfterSimulationRunCode>if (
		!root.arrivals_closed
		|| root.guard_hit
		|| root.admitted_at_cutoff != root.arrival_times.size()
		|| root.completed_at_cutoff != root.completed
		|| root.completed != root.arrival_times.size()
		|| root.travellerSource.count() != root.arrival_times.size()
	) {
		throw new IllegalStateException(
			"HPP arrival verification failed flow conservation"
		);
	}
	double previousArrival = -1.0;
	for ( double arrivalTime : root.arrival_times ) {
		if (
			!Double.isFinite( arrivalTime )
			|| arrivalTime &lt; 0.0
			|| arrivalTime &gt;= root.arrival_cutoff_seconds
			|| arrivalTime &lt;= previousArrival
		) {
			throw new IllegalStateException(
				"Invalid HPP arrival timestamp: " + arrivalTime
			);
		}
		previousArrival = arrivalTime;
	}

	double expectedCount =
		root.arrival_rate_per_second * root.arrival_cutoff_seconds;
	String manifest =
		"schema_version,experiment_role,readiness_scope,source_config_id,"
		+ "input_sample_id,replication_id,arrival_evidence_id,arrival_assumption,"
		+ "arrival_rate_per_second,arrival_cutoff_seconds,arrival_seed,"
		+ "expected_count,realized_count,guard_limit,guard_hit,engine_version\n"
		+ String.join(
			",",
			new String[] {
				"1.0",
				"DEMAND_MECHANISM_VERIFICATION",
				"ARRIVAL_ONLY",
