					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Traveller traveller = (Traveller) agent;
traveller.exit = time();
completed_travellers++;
last_exit = Math.max( last_exit, traveller.exit );
security_waits.add( traveller.security_start - traveller.security_queue_join );
system_times.add( traveller.exit - traveller.arrival );
entity_rows.add(
	String.join(
		",",
		new String[] {
			"1.0",
			scenario_id,
			input_sample_id,
			Integer.toString( replication_id ),
			"default_rng:" + Long.toString( run_seed ),
			traveller.traveller_id,
			String.format( java.util.Locale.ROOT, "%.9f", traveller.arrival ),
			String.format( java.util.Locale.ROOT, "%.9f", traveller.security_queue_join ),
			String.format( java.util.Locale.ROOT, "%.9f", traveller.security_start ),
			String.format( java.util.Locale.ROOT, "%.9f", traveller.security_end ),
			"",
			"",
			"",
			"",
			"false",
			"",
			"false",
			String.format( java.util.Locale.ROOT, "%.9f", traveller.exit ),
			"SECURITY_DELAY_1",
			"",
			String.format( java.util.Locale.ROOT, "%.9f", traveller.service_demand )
		}
	)
);]]></Code>
							</Value>
