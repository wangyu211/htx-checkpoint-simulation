							<Value Class="CodeValue">
								<Code><![CDATA[CheckpointTraveller traveller = (CheckpointTraveller) agent;
int sequence = ++admitted;
traveller.traveller_id = String.format(
	java.util.Locale.ROOT,
	"VERIFY_R%02d_T%03d",
	replication_id,
	sequence
);
traveller.input_sample_id = input_sample_id;
traveller.replication_id = replication_id;
traveller.arrival = time();
traveller.security_service_demand = security_service_p1_seconds;
traveller.immigration_service_demand = immigration_service_p1_seconds;]]></Code>
