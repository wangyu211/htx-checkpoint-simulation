			<AfterSimulationRunCode>if (
		!"VERIFY_TWO_STAGE_A".equals( root.config_id )
		|| !"two_stage_six_person_fixture".equals( root.arrival_fixture_id )
	) {
		throw new IllegalStateException(
			"Two-stage verification must use the pinned oracle configuration"
		);
	}
	if (
		root.max_arrivals &lt; 1
		|| root.arrival_cutoff_seconds &lt; 0.0
		|| root.security_capacity &lt; 1
		|| root.immigration_capacity &lt; 1
		|| root.security_queue_capacity &lt; 1
		|| root.immigration_queue_capacity &lt; 1
		|| root.security_service_p1_seconds &lt;= 0.0
		|| root.immigration_service_p1_seconds &lt;= 0.0
		|| root.oracle_first_arrival_seconds &lt; 0.0
		|| root.oracle_early_interarrival_seconds &lt;= 0.0
		|| root.oracle_late_interarrival_seconds &lt;= 0.0
		|| root.oracle_interval_switch_after &lt; 1
		|| root.oracle_interval_switch_after &gt;= root.max_arrivals
	) {
		throw new IllegalStateException(
			"Two-stage verification parameters violate the fail-fast domain"
		);
	}
	if (
		root.admitted != root.max_arrivals
		|| root.completed != root.max_arrivals
	) {
		throw new IllegalStateException(
			"Two-stage verification expected "
			+ root.max_arrivals
			+ " admitted/completed; admitted="
			+ root.admitted
			+ ", completed="
			+ root.completed
		);
	}
	if (
		root.security_queue_count != 0
		|| root.security_in_service_count != 0
		|| root.immigration_queue_count != 0
		|| root.immigration_in_service_count != 0
	) {
		throw new IllegalStateException( "Two-stage verification did not drain" );
	}
	if (
		root.completed_at_cutoff != 1
		|| root.security_queue_at_cutoff != 2
		|| root.security_in_service_at_cutoff != 1
		|| root.immigration_queue_at_cutoff != 1
		|| root.immigration_in_service_at_cutoff != 1
	) {
		throw new IllegalStateException(
			"Unexpected cutoff state: completed="
			+ root.completed_at_cutoff
			+ ", security_queue="
			+ root.security_queue_at_cutoff
			+ ", security_in_service="
			+ root.security_in_service_at_cutoff
			+ ", immigration_queue="
			+ root.immigration_queue_at_cutoff
			+ ", immigration_in_service="
			+ root.immigration_in_service_at_cutoff
		);
	}
	if ( Math.abs( root.last_exit - 20.0 ) &gt; 1e-9 ) {
		throw new IllegalStateException(
			"Expected drain end 20.0, found " + root.last_exit
		);
	}
	if ( root.entity_rows.size() != root.max_arrivals ) {
		throw new IllegalStateException(
			"Expected "
			+ root.max_arrivals
			+ " entity rows, found "
			+ root.entity_rows.size()
		);
	}

	java.util.ArrayList&lt;Double&gt; securityWaits =
		new java.util.ArrayList&lt;Double&gt;( root.security_waits );
	java.util.ArrayList&lt;Double&gt; immigrationWaits =
		new java.util.ArrayList&lt;Double&gt;( root.immigration_waits );
	java.util.ArrayList&lt;Double&gt; totalQueueWaits =
		new java.util.ArrayList&lt;Double&gt;( root.total_queue_waits );
	java.util.ArrayList&lt;Double&gt; systemTimes =
		new java.util.ArrayList&lt;Double&gt;( root.system_times );
	java.util.Collections.sort( securityWaits );
	java.util.Collections.sort( immigrationWaits );
	java.util.Collections.sort( totalQueueWaits );
	java.util.Collections.sort( systemTimes );

	double securityWaitSum = 0.0;
	for ( double value : securityWaits ) {
		securityWaitSum += value;
	}
	double immigrationWaitSum = 0.0;
	for ( double value : immigrationWaits ) {
		immigrationWaitSum += value;
	}
	double totalQueueWaitSum = 0.0;
	for ( double value : totalQueueWaits ) {
		totalQueueWaitSum += value;
	}
	double systemTimeSum = 0.0;
	for ( double value : systemTimes ) {
		systemTimeSum += value;
	}
	int p95Index = Math.max(
		0,
		(int) Math.ceil( 0.95 * securityWaits.size() ) - 1
	);

	String manifest =
		"schema_version,verification_contract_hash,model_version,experiment_role,"
		+ "scenario_id,input_sample_id,replication_id,stream_seed_ids,start_state,"
		+ "arrival_cutoff,drain_end,engine_version\n"
		+ String.join(
			",",
			new String[] {
				"1.0",
				"daf13e43beb453b10855dd69ecbeeef65e05afbaf75da070052ddfca1cf58dcb",
				"two-stage-verification-v0.1",
				"SYNTHETIC_MECHANISM_VERIFICATION",
				root.scenario_id,
				root.input_sample_id,
				Integer.toString( root.replication_id ),
				"fixed_oracle:2026072709",
				"EMPTY",
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					root.arrival_cutoff_seconds
				),
				String.format( java.util.Locale.ROOT, "%.9f", root.last_exit ),
				"AnyLogic PLE 8.9.9.202607020720"
			}
		)
		+ "\n";

	String entityHeader =
		"schema_version,experiment_role,scenario_id,input_sample_id,replication_id,"
		+ "stream_seed_ids,traveller_id,arrival,security_queue_join,security_start,"
		+ "security_end,immigration_queue_join,immigration_lane,immigration_start,"
		+ "immigration_primary_end,additional_check_flag,additional_check_end,"
		+ "technology_flag,exit,security_resource_id,immigration_resource_id,"
		+ "security_service_demand,immigration_service_demand\n";
	String entityLog = entityHeader + String.join( "\n", root.entity_rows ) + "\n";

	int wipAtCutoff =
		root.security_queue_at_cutoff
		+ root.security_in_service_at_cutoff
		+ root.immigration_queue_at_cutoff
		+ root.immigration_in_service_at_cutoff;
	String summary =
		"schema_version,experiment_role,scenario_id,input_sample_id,replication_id,"
		+ "stream_seed_ids,arrivals,completed_at_cutoff,security_queue_at_cutoff,"
		+ "security_in_service_at_cutoff,immigration_queue_at_cutoff,"
		+ "immigration_in_service_at_cutoff,wip_at_cutoff,completed_after_drain,"
		+ "security_wait_mean,security_wait_p95,immigration_wait_mean,"
		+ "immigration_wait_p95,total_queue_wait_mean,total_queue_wait_p95,"
		+ "system_time_mean,system_time_p95,cutoff_backlog,"
		+ "cohort_clear_time_after_cutoff\n"
		+ String.join(
			",",
			new String[] {
				"1.0",
				"SYNTHETIC_MECHANISM_VERIFICATION",
				root.scenario_id,
				root.input_sample_id,
				Integer.toString( root.replication_id ),
				"fixed_oracle:2026072709",
				Integer.toString( root.admitted ),
				Integer.toString( root.completed_at_cutoff ),
				Integer.toString( root.security_queue_at_cutoff ),
				Integer.toString( root.security_in_service_at_cutoff ),
				Integer.toString( root.immigration_queue_at_cutoff ),
				Integer.toString( root.immigration_in_service_at_cutoff ),
				Integer.toString( wipAtCutoff ),
				Integer.toString( root.completed ),
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					securityWaitSum / securityWaits.size()
				),
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					securityWaits.get( p95Index )
				),
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					immigrationWaitSum / immigrationWaits.size()
				),
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					immigrationWaits.get( p95Index )
				),
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					totalQueueWaitSum / totalQueueWaits.size()
				),
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					totalQueueWaits.get( p95Index )
				),
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					systemTimeSum / systemTimes.size()
				),
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					systemTimes.get( p95Index )
				),
				Integer.toString( root.admitted - root.completed_at_cutoff ),
				String.format(
					java.util.Locale.ROOT,
					"%.9f",
					root.last_exit - root.arrival_cutoff_seconds
				)
			}
		)
		+ "\n";

	java.io.File probe = new java.io.File(
		System.getProperty( "htx.repo.root", System.getProperty( "user.dir" ) )
	).getAbsoluteFile();
	while (
		probe != null
		&amp;&amp; !new java.io.File( probe, "config/anylogic_gate_manifest.csv" ).isFile()
	) {
		probe = probe.getParentFile();
	}
	if ( probe == null ) {
		throw new IllegalStateException(
			"Cannot locate repository root for two-stage verification"
		);
	}
	java.io.File outputDirectory = new java.io.File(
		probe,
		"results/raw/anylogic_two_stage_verification"
	).getAbsoluteFile();
	try {
		java.nio.file.Files.createDirectories( outputDirectory.toPath() );
		java.nio.file.Files.write(
			new java.io.File( outputDirectory, "run_manifest.csv" ).toPath(),
			manifest.getBytes( java.nio.charset.StandardCharsets.UTF_8 ),
			java.nio.file.StandardOpenOption.CREATE,
			java.nio.file.StandardOpenOption.TRUNCATE_EXISTING,
			java.nio.file.StandardOpenOption.WRITE
		);
		java.nio.file.Files.write(
			new java.io.File( outputDirectory, "entity_log.csv" ).toPath(),
			entityLog.getBytes( java.nio.charset.StandardCharsets.UTF_8 ),
			java.nio.file.StandardOpenOption.CREATE,
			java.nio.file.StandardOpenOption.TRUNCATE_EXISTING,
			java.nio.file.StandardOpenOption.WRITE
		);
		java.nio.file.Files.write(
			new java.io.File( outputDirectory, "run_summary.csv" ).toPath(),
			summary.getBytes( java.nio.charset.StandardCharsets.UTF_8 ),
			java.nio.file.StandardOpenOption.CREATE,
			java.nio.file.StandardOpenOption.TRUNCATE_EXISTING,
			java.nio.file.StandardOpenOption.WRITE
		);
	} catch ( java.io.IOException exception ) {
		throw new RuntimeException(
			"Cannot write two-stage verification outputs",
			exception
		);
	}</AfterSimulationRunCode>
