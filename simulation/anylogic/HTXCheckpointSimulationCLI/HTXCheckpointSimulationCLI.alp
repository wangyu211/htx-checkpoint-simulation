		<SimulationExperiment ActiveObjectClassId="1785162520364">
			<Id>1785162602457</Id>
			<Name><![CDATA[OperationalInteractive]]></Name>
			<CommandLineArguments/>
			<MaximumMemory>512</MaximumMemory>
