			manifestRow.getBytes( java.nio.charset.StandardCharsets.UTF_8 ),
			java.nio.file.StandardOpenOption.APPEND
		);
		java.nio.file.Files.write(
			new java.io.File( gate_output_dir, "entity_log.csv" ).toPath(),
			entityRows.getBytes( java.nio.charset.StandardCharsets.UTF_8 ),
			java.nio.file.StandardOpenOption.APPEND
		);
		java.nio.file.Files.write(
