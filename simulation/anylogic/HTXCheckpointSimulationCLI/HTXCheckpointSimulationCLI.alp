			<EmbeddedObject>
				<Id>1785163120501</Id>
				<Name><![CDATA[checkpointSink]]></Name>
				<X>850</X>
				<Y>280</Y>
				<Label><X>-10</X><Y>-24</Y></Label>
				<PublicFlag>false</PublicFlag>
				<PresentationFlag>true</PresentationFlag>
				<ShowLabel>true</ShowLabel>
				<ActiveObjectClass>
					<PackageName>com.anylogic.libraries.processmodeling</PackageName>
					<ClassName>Sink</ClassName>
				</ActiveObjectClass>
				<GenericParameterSubstitute>
					<GenericParameterSubstituteReference>
						<PackageName>com.anylogic.libraries.processmodeling</PackageName>
						<ClassName>Sink</ClassName>
						<ItemName>1412336242929</ItemName>
					</GenericParameterSubstituteReference>
				</GenericParameterSubstitute>
				<Parameters>
					<Parameter>
						<Name><![CDATA[onEnter]]></Name>
						<Value Class="CodeValue">
							<Code><![CDATA[OperationalTraveller traveller = (OperationalTraveller) agent;
		traveller.exit = time();
		completed++;
		last_exit = traveller.exit;
		if ( presentation_animation_enabled ) {
			refreshPresentationAnimation();
			traveller.jumpTo( 850.0, 290.0 );
		}
		double securityWait = traveller.security_start - traveller.security_queue_join;
		double immigrationWait = traveller.immigration_start - traveller.immigration_queue_join;
		double totalQueueWait = securityWait + immigrationWait;
		double systemTime = traveller.exit - traveller.arrival;
		security_waits.add( securityWait );
		immigration_waits.add( immigrationWait );
		total_queue_waits.add( totalQueueWait );
		system_times.add( systemTime );
		if ( totalQueueWait > 600.0 ) exceed_600_count++;
		if ( totalQueueWait > 900.0 ) exceed_900_count++;
		if ( totalQueueWait > 1200.0 ) exceed_1200_count++;
		entity_log_rows.add(
			String.join(
				",",
				new String[] {
					schema_version,
					config_id,
					config_sha256,
					model_version,
					scenario_id,
					traveller.input_sample_id,
					Integer.toString( traveller.replication_id ),
					traveller.traveller_id,
					String.format( java.util.Locale.ROOT, "%.9f", traveller.arrival ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.security_service_demand ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.immigration_conventional_service_demand ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.automation_u ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.additional_check_u ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.lane_tie_u ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.security_queue_join ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.security_start ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.security_end ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.immigration_queue_join ),
					traveller.immigration_lane_id,
					String.format( java.util.Locale.ROOT, "%.9f", traveller.immigration_start ),
					Boolean.toString( traveller.technology_flag ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.immigration_primary_service_demand ),
					String.format( java.util.Locale.ROOT, "%.9f", traveller.immigration_primary_end ),
					Boolean.toString( traveller.additional_check_flag ),
					traveller.additional_check_flag
						? String.format( java.util.Locale.ROOT, "%.9f", traveller.additional_check_service_demand )
						: "",
					traveller.additional_check_flag
						? String.format( java.util.Locale.ROOT, "%.9f", traveller.additional_check_end )
						: "",
					String.format( java.util.Locale.ROOT, "%.9f", traveller.exit ),
					traveller.security_resource_id,
					traveller.immigration_resource_id
				}
			)
		);
		if ( arrivals_closed && completed == admitted ) {
			run_status = "COMPLETE";
			finishSimulation();
		}]]></Code>
						</Value>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destroyEntity]]></Name>
					</Parameter>
