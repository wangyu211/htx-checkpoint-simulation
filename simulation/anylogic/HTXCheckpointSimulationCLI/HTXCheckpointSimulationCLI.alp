			+ "security_wait_mean_seconds,security_wait_p95_seconds,"
			+ "immigration_wait_mean_seconds,immigration_wait_p95_seconds,"
			+ "total_queue_wait_mean_seconds,total_queue_wait_p95_seconds,"
			+ "total_queue_wait_exceed_600_rate,total_queue_wait_exceed_900_rate,"
			+ "total_queue_wait_exceed_1200_rate,system_time_mean_seconds,"
			+ "system_time_p95_seconds,security_utilization,immigration_utilization,"
			+ "cutoff_backlog,cutoff_backlog_fraction,"
			+ "cohort_clear_time_after_cutoff_seconds,conservation_pass,run_status"
		);
		kpis.add( String.join( ",", new String[] {
			root.schema_version, root.config_id, root.config_sha256, root.model_version,
			root.scenario_id, root.input_sample_id, Integer.toString( root.replication_id ),
			number.apply( root.arrival_cutoff_seconds ), number.apply( drainEnd ),
			Integer.toString( root.admitted ), Integer.toString( root.completed_at_cutoff ),
			Integer.toString( root.security_queue_at_cutoff ),
			Integer.toString( root.security_in_service_at_cutoff ),
			Integer.toString( root.immigration_queue_at_cutoff ),
			Integer.toString( root.immigration_in_service_at_cutoff ),
			Integer.toString( wipAtCutoff ), Integer.toString( root.completed ),
			Integer.toString( root.rejected_or_dropped_count ),
			Integer.toString( root.technology_count ),
			Integer.toString( root.additional_check_count ),
			number.apply( securitySum / n ), number.apply( securitySorted.get( p95Index ) ),
			number.apply( immigrationSum / n ), number.apply( immigrationSorted.get( p95Index ) ),
			number.apply( totalSum / n ), number.apply( totalSorted.get( p95Index ) ),
			number.apply( (double) root.exceed_600_count / n ),
			number.apply( (double) root.exceed_900_count / n ),
			number.apply( (double) root.exceed_1200_count / n ),
			number.apply( systemSum / n ), number.apply( systemSorted.get( p95Index ) ),
			number.apply( securityUtilization ), number.apply( immigrationUtilization ),
			Integer.toString( cutoffBacklog ),
			number.apply( root.admitted_at_cutoff &gt; 0
				? (double) cutoffBacklog / root.admitted_at_cutoff : 0.0 ),
			number.apply( Math.max( 0.0, drainEnd - root.arrival_cutoff_seconds ) ),
			Boolean.toString( conservationPass ), root.run_status
		} ) );
		java.nio.file.Files.write(
			runDirectory.resolve( "run_manifest.csv" ), manifest,
			java.nio.charset.StandardCharsets.UTF_8
		);
		java.nio.file.Files.write(
			runDirectory.resolve( "entity_log.csv" ), entities,
			java.nio.charset.StandardCharsets.UTF_8
		);
		java.nio.file.Files.write(
			runDirectory.resolve( "replication_kpis.csv" ), kpis,
			java.nio.charset.StandardCharsets.UTF_8
		);
	} catch ( java.io.IOException exception ) {
		throw new RuntimeException( "Operational CSV export failed", exception );
	}</AfterSimulationRunCode>
