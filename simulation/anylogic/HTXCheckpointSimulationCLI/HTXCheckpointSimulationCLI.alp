			+ root.replication_id
			+ ": arrivals="
			+ root.next_traveller_id
			+ ", completed="
			+ root.completed_travellers
		);
	}

	java.util.ArrayList&lt;Double&gt; sortedSecurityWaits =
		new java.util.ArrayList&lt;Double&gt;( root.security_waits );
	java.util.ArrayList&lt;Double&gt; sortedSystemTimes =
		new java.util.ArrayList&lt;Double&gt;( root.system_times );
	java.util.Collections.sort( sortedSecurityWaits );
	java.util.Collections.sort( sortedSystemTimes );

	double securityWaitSum = 0.0;
	for ( double value : sortedSecurityWaits ) {
		securityWaitSum += value;
	}
	double systemTimeSum = 0.0;
	for ( double value : sortedSystemTimes ) {
		systemTimeSum += value;
	}
	int securityP95Index = Math.max(
		0,
		(int) Math.ceil( 0.95 * sortedSecurityWaits.size() ) - 1
	);
	int systemP95Index = Math.max(
		0,
		(int) Math.ceil( 0.95 * sortedSystemTimes.size() ) - 1
	);
	double securityWaitMean = securityWaitSum / sortedSecurityWaits.size();
	double securityWaitP95 = sortedSecurityWaits.get( securityP95Index );
	double systemTimeMean = systemTimeSum / sortedSystemTimes.size();
	double systemTimeP95 = sortedSystemTimes.get( systemP95Index );
	int cutoffBacklog = root.gate_entity_count - root.completed_travellers;
	String streamSeedIds = "default_rng:" + Long.toString( root.run_seed );

	String manifestRow = String.join(
